# توکن ربات تلگرام (از @BotFather بگیر)
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# یوزرنیم و پسورد اکانت اینستاگرامی که مخصوص این ربات ساختی
INSTAGRAM_USERNAME=your_bot_instagram_username
INSTAGRAM_PASSWORD=your_bot_instagram_password

# هر چند ثانیه یک‌بار دایرکت اینستاگرام چک شود (پیش‌فرض 45)
POLL_INTERVAL_SECONDS=45

# آیدی عددی تلگرام ادمین (یا چند نفر با کاما جدا کن). با ربات @userinfobot
# می‌تونی آیدی عددی خودت رو پیدا کنی. پنل مدیریت (/admin) فقط برای این آیدی‌ها کار می‌کنه
# و کد ۲مرحله‌ای/چالش امنیتی اینستاگرام هم از همینجا پرسیده می‌شه.
ADMIN_TELEGRAM_IDS=123456789

# مسیر ذخیره‌سازی داده‌ها (سشن، لینک‌ها و...). روی ریلیوی این را برابر مسیر
# Volume (مثلاً /data) بگذار.
DATA_DIR=

# مدت زمان انتظار برای دریافت کد ورود از ادمین (ثانیه)
CODE_WAIT_TIMEOUT_SECONDS=600

# --- پروکسی برای لاگین اینستاگرام (اختیاری) ---
# روش پیشنهادی: هیچ‌کدوم از این‌ها رو پر نکن! از پنل مدیریت تلگرام (/admin)
# دکمه‌ی «🔧 تنظیم پروکسی VLESS» یا «🔌 تنظیم پروکسی مستقیم» رو بزن و
# لینک/آدرس پروکسی رو همونجا بفرست. این متغیرها فقط برای کسایی که ترجیح
# می‌دن از Railway مدیریت کنن، اختیاری موندن (و اگه پر بشن، اولویت رو از
# پنل می‌گیرن):

# گزینه ۱: یک پروکسی معمولی HTTP/SOCKS5 داری (اولویت اول)
IG_PROXY=

# گزینه ۲: کانفیگ VLESS/V2Ray داری
PROXY_VLESS_URL=
